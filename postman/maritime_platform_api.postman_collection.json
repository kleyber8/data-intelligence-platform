{
  "info": {
    "name": "Maritime Platform API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Token",
          "request": {
            "method": "POST",
            "url": "http://localhost:8000/api/v1/auth/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "admin" },
                { "key": "password", "value": "admin_api_secret" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Ports",
      "item": [
        {
          "name": "List Ports",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/ports/"
          }
        },
        {
          "name": "Port Congestion",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/ports/SGSIN/congestion"
          }
        }
      ]
    },
    {
      "name": "Vessels",
      "item": [
        {
          "name": "Get Vessel",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/vessels/314257751"
          }
        }
      ]
    }
  ]
}
