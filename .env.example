# ============================================================
# Data Intelligence Platform — Variables de entorno
# Copiar a .env y ajustar. NUNCA versionar .env.
# ============================================================

# ---------- Aplicación ----------
APP_NAME=data-intelligence-platform
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
TIMEZONE=UTC

# ---------- Data Lake local ----------
DATA_LAKE_ROOT=/home/kley_8/Projects/data-intelligence-platform/data
DATA_LAKE_RAW_DIR=${DATA_LAKE_ROOT}/raw
DATA_LAKE_BRONZE_DIR=${DATA_LAKE_ROOT}/bronze
DATA_LAKE_SILVER_DIR=${DATA_LAKE_ROOT}/silver
DATA_LAKE_GOLD_DIR=${DATA_LAKE_ROOT}/gold
DATA_LAKE_QUARANTINE_DIR=${DATA_LAKE_ROOT}/quarantine
DATA_LAKE_METADATA_DIR=${DATA_LAKE_ROOT}/metadata

# ---------- S3 / MinIO (Fase 1 usa MinIO) ----------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_RAW=maritime-raw
S3_BUCKET_BRONZE=maritime-bronze
S3_REGION=us-east-1

# ---------- PostgreSQL (proyecto) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=maritime
POSTGRES_USER=maritime_user
POSTGRES_PASSWORD=change_me_dev_only

# ---------- PostgreSQL (metadata Airflow) ----------
AIRFLOW_POSTGRES_HOST=localhost
AIRFLOW_POSTGRES_PORT=5433
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=change_me_dev_only

# ---------- Airflow ----------
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ---------- dbt ----------
DBT_PROFILES_DIR=/home/kley_8/.dbt
DBT_TARGET=dev

# ---------- FastAPI ----------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ---------- Fuentes externas ----------
NOAA_AIS_BASE_URL=https://coast.noaa.gov/htdata/CMSP/AISDataHandler/
NOAA_TRACKS_BASE_URL=https://www.ncei.noaa.gov/data/
WORLD_PORT_INDEX_URL=https://msi.nga.mil/api/publications/download

# ---------- AWS (vacío en Fase 1) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ---------- Snowflake (vacío) ----------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# ---------- Gemini (vacío) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
